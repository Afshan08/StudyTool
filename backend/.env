# Focus Journal - Environment Configuration
# This file is for your LOCAL development environment.
# For production, change DEBUG=False and fill in your real PostgreSQL credentials.

# Django
DJANGO_SECRET_KEY=django-dev-secret-key-please-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (set DB_ENGINE to postgresql to use PostgreSQL)
# For development with SQLite, leave DB_ENGINE as sqlite3 (default)
DB_ENGINE=django.db.backends.sqlite3

# PostgreSQL credentials (only needed when DB_ENGINE=django.db.backends.postgresql)
DB_NAME=focus_journal_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
